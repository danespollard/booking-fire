<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold text-amber-900">Templates</h1>
  <%= link_to "New template", new_template_path, class: "px-4 py-2 text-sm font-medium text-white bg-amber-600 rounded-lg hover:bg-amber-500" %>
</div>

<% if @templates.empty? %>
  <p class="text-gray-500">No templates yet.</p>
<% else %>
  <div class="space-y-4">
    <% @templates.each do |template| %>
      <div class="bg-white rounded-xl shadow-sm border border-amber-100 p-5">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <h2 class="font-semibold text-amber-900 mb-1"><%= template.name %></h2>
            <pre class="text-xs text-gray-600 whitespace-pre-wrap truncate"><%= template.body %></pre>
          </div>
          <div class="flex gap-2 shrink-0">
            <%= link_to "Edit", edit_template_path(template), class: "text-sm text-amber-600 hover:text-amber-800" %>
            <%= button_to "Delete", template_path(template), method: :delete, data: { turbo_confirm: "Delete this template?" }, class: "text-sm text-red-500 hover:text-red-700 cursor-pointer bg-transparent border-none p-0" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<div class="mt-6">
  <%= link_to "← Back to calendar", root_path, class: "text-sm text-amber-600 hover:text-amber-800" %>
</div>
