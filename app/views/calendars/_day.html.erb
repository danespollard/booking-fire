<%= turbo_frame_tag "day-#{day}" do %>
  <div class="relative h-full rounded-lg p-1.5 text-left transition cursor-pointer hover:ring-1 hover:ring-inset hover:ring-gray-200 <%= day_cell_classes(block) %>"
       data-controller="day-modal"
       data-action="click->day-modal#open">
    <span class="text-xs font-medium text-gray-700"><%= day.day %></span>
    <div class="mt-1"><%= day_status_label(block) %></div>
    <% if block&.client_name.present? %>
      <div class="text-[9px] text-gray-600 truncate mt-0.5"><%= block.client_name %></div>
    <% end %>

    <dialog data-day-modal-target="dialog"
            data-action="click->day-modal#backdropClick">
      <div class="day-sheet w-full bg-white rounded-t-3xl shadow-2xl
                  md:rounded-2xl md:w-96">

        <div class="flex justify-center pt-3 pb-1 md:hidden">
          <div class="w-10 h-1 bg-gray-300 rounded-full"></div>
        </div>

        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide">
              <%= day.strftime("%A") %>
            </p>
            <p class="text-xl font-semibold text-gray-900">
              <%= day.strftime("%B %-d") %>
            </p>
          </div>
          <button type="button"
                  data-action="click->day-modal#close"
                  class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors text-xl leading-none">
            ×
          </button>
        </div>

        <% form_attrs = block ? { model: block } : { url: availability_blocks_toggle_path, scope: :availability_block } %>
        <%= form_with(**form_attrs) do |f| %>
          <%= hidden_field_tag :date, day unless block %>

          <div class="px-4 pt-4 pb-2">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2 px-1">Status</p>
            <div class="status-chip-row">
              <% { "open" => ["Open", "status-open", "bg-emerald-500"],
                   "hold" => ["Hold", "status-hold", "bg-amber-500"],
                   "booked" => ["Booked", "status-booked", "bg-rose-500"] }.each_with_index do |(s, (label, chip_class, dot_class)), i| %>
                <% active = block ? block.status == s : i == 0 %>
                <label class="status-chip <%= chip_class %> rounded-xl border-2 cursor-pointer">
                  <%= f.radio_button :status, s, checked: active %>
                  <span class="w-3 h-3 rounded-full <%= dot_class %>"></span>
                  <span class="text-sm font-semibold"><%= label %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="px-4 pt-2 pb-2">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide mb-2 px-1">Time</p>
            <div class="time-chip-grid">
              <% { anytime: "Anytime", daytime: "Daytime", evening: "Evening", after_9pm: "After 9pm" }.each_with_index do |(value, label), i| %>
                <% active = block ? block.time_label == value.to_s : i == 0 %>
                <label class="time-chip rounded-xl border-2 cursor-pointer">
                  <%= f.radio_button :time_label, value, checked: active %>
                  <span class="text-sm font-medium"><%= label %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div class="px-4 pt-2 pb-2">
            <div class="flex gap-2 items-center bg-gray-50 rounded-2xl px-4 py-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: #9ca3af; flex-shrink: 0;">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
              </svg>
              <%= f.text_field :client_name,
                  placeholder: "Client name",
                  class: "flex-1 min-w-0 bg-transparent text-sm text-gray-800 placeholder-gray-400 focus:outline-none" %>
            </div>
          </div>

          <div class="px-4 pt-1 pb-5">
            <%= f.submit "Save", class: "w-full py-3.5 text-center text-white font-medium bg-amber-600 hover:bg-amber-500 transition-colors rounded-2xl cursor-pointer" %>
          </div>
        <% end %>

        <% if block %>
          <div class="px-4 pb-5 -mt-3">
            <%= button_to availability_block_path(block), method: :delete,
                class: "w-full py-3.5 text-center text-red-600 font-medium bg-red-50 hover:bg-red-100 transition-colors rounded-2xl cursor-pointer" do %>
              Remove Availability
            <% end %>
          </div>
        <% end %>

      </div>
    </dialog>
  </div>
<% end %>
