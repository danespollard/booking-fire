<div class="flex flex-col gap-3 mb-6 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-bold text-amber-900"><%= @date.strftime("%B %Y") %></h1>
  <nav class="flex items-center gap-2 ml-auto">
    <%= link_to "← Prev", calendar_path(date: @month_start - 1.month), class: "px-3 py-1.5 text-sm font-medium text-amber-700 bg-white border border-amber-300 rounded-lg hover:bg-amber-50" %>
    <%= link_to "Next →", calendar_path(date: @month_end + 1.day), class: "px-3 py-1.5 text-sm font-medium text-amber-700 bg-white border border-amber-300 rounded-lg hover:bg-amber-50" %>
  </nav>
</div>

<div class="calendar-grid-wrap bg-white rounded-xl shadow-sm border border-amber-100 overflow-x-auto">
  <table class="calendar-grid-table w-full min-w-[700px] border-collapse">
    <thead>
      <tr class="bg-amber-100">
        <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day_name| %>
          <th class="calendar-grid-head px-2 py-2 text-xs font-semibold text-amber-800 text-center min-w-[100px]"><%= day_name %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% (@month_start.beginning_of_week(:sunday)..@month_end.end_of_week(:sunday)).each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <td class="calendar-grid-cell border border-gray-200 h-24 align-top p-1 min-w-[100px]">
              <% if day.month == @date.month %>
                <%= render "calendars/day", day: day, block: @blocks[day] %>
              <% else %>
                <span class="calendar-outside-day text-xs text-gray-300 p-1"><%= day.day %></span>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "calendars/openings", month: @month_start, templates: @templates %>
