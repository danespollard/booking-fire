<% dates = user.openings_dates(month: month.first_day) %>
<% blocks = user.availability_blocks.where(date: dates).order(:date).to_a %>
<% templates = user.templates.ordered %>
<% error = local_assigns[:error] %>
<%= turbo_frame_tag "openings" do %>
  <div class="mt-8 bg-white rounded-xl shadow-sm border border-amber-100 p-4 sm:p-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-amber-900">Your Openings</h2>
      <%= link_to "Edit templates", templates_path, class: "text-xs text-amber-600 hover:text-amber-800", data: { turbo_frame: "_top" } %>
    </div>
    <%= form_with model: user, url: openings_range_path, method: :patch, class: "mb-4", data: { controller: "autosubmit" } do |f| %>
      <%= hidden_field_tag :month, month.to_param %>
      <div class="flex flex-wrap items-center gap-2">
        <%= f.label :openings_range, "Dates", class: "text-xs font-medium text-amber-800" %>
        <%= f.select :openings_range, openings_range_options(month), {}, class: "rounded-md border border-amber-300 bg-white px-2 py-1 text-sm text-amber-900", data: { action: "autosubmit#submit" } %>
        <% if user.openings_range == "custom" %>
          <%= f.label :openings_from, "From", class: "sr-only" %>
          <%= f.date_field :openings_from, class: "rounded-md border border-amber-300 bg-white px-2 py-1 text-sm text-amber-900", data: { action: "autosubmit#submit" } %>
          <span class="text-xs text-amber-700">to</span>
          <%= f.label :openings_to, "To", class: "sr-only" %>
          <%= f.date_field :openings_to, class: "rounded-md border border-amber-300 bg-white px-2 py-1 text-sm text-amber-900", data: { action: "autosubmit#submit" } %>
        <% end %>
        <noscript><%= f.submit "Update", class: "px-2 py-1 text-xs font-medium text-white bg-amber-600 rounded-md" %></noscript>
      </div>
      <p class="mt-1 text-xs text-amber-700"><%= openings_range_summary(dates) %></p>
      <% if error %>
        <p class="mt-1 text-xs text-rose-700"><%= error %></p>
      <% end %>
    <% end %>
    <div data-controller="tabs">
      <div class="flex gap-2 mb-4 border-b border-amber-100 pb-2 overflow-x-auto">
        <% templates.each_with_index do |template, i| %>
          <button
            data-tabs-target="tab"
            data-action="click->tabs#select"
            data-active="<%= i == 0 %>"
            class="px-3 py-1 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 data-[active=true]:bg-amber-600 data-[active=true]:text-white data-[active=false]:text-amber-700 data-[active=false]:hover:bg-amber-50"
          ><%= template.name %></button>
        <% end %>
      </div>
      <% templates.each_with_index do |template, i| %>
        <div data-tabs-target="panel" <%= i > 0 ? "hidden" : "" %>>
          <div data-controller="clipboard">
            <pre class="bg-amber-50 rounded-lg p-4 text-sm text-amber-900 mb-4 whitespace-pre-wrap" data-clipboard-target="source"><%= render_template(template.body, blocks) %></pre>
            <button data-action="click->clipboard#copy" data-clipboard-target="button" class="px-4 py-2 text-sm font-medium text-white bg-amber-600 rounded-lg hover:bg-amber-500 cursor-pointer transition-colors">Copy</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
